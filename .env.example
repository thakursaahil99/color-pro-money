# ---- ColorProMoney configuration (VIRTUAL POINTS ONLY) ----
NODE_ENV=development
PORT=3000
# Public origin of the site, used for CSRF origin checks
APP_ORIGIN=http://localhost:3000

# PostgreSQL connection
DATABASE_URL=postgres://postgres:postgres@localhost:5432/colorpromoney
# Separate database used by the automated tests (it is wiped by tests!)
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/colorpromoney_test
# Set to "true" for hosted Postgres that requires SSL (Neon, Supabase, Render...)
DATABASE_SSL=false

# Session lifetime in hours
SESSION_TTL_HOURS=168

# Demo mode: allows `npm run db:seed` to insert mock users/rounds. Never enable in production.
DEMO_MODE=true

# Virtual points given to every new account (0 = start empty)
STARTING_POINTS=0

# Virtual points the referrer gets for each friend who registers with their code
REFERRAL_BONUS_POINTS=150

